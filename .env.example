# ============================================================
# VIGILUX - CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
# For Docker: use service name "db" as host
# For local dev: use "localhost" as host
DATABASE_URL=postgresql://vigilux_user:vigilux_password@db:5432/vigilux

# ============================================================
# SECURITY CONFIGURATION
# ============================================================
# Secret key for JWT token signing (MUST BE CHANGED IN PRODUCTION!)
# Generate a secure key with: openssl rand -hex 32
# NEVER use the default value in production!
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# JWT token expiration time in minutes (default: 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Algorithm used for JWT encoding (HS256 recommended)
ALGORITHM=HS256

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Allowed origins for CORS (comma-separated or JSON array)
# Development: http://localhost:3000
# Production: https://yourdomain.com
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'

# ============================================================
# REDIS CONFIGURATION (Message Broker & Cache)
# ============================================================
# Redis connection URL for Celery and caching
# Format: redis://host:port/db
REDIS_URL=redis://redis:6379/0

# Individual Redis connection parameters (optional, used if REDIS_URL not set)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================================
# APIFY CONFIGURATION (Web Scraping Service)
# ============================================================
# Apify API Token for Google Maps scraping and competitor data extraction
# How to get:
#   1. Create account at https://apify.com
#   2. Go to Settings > Integrations > API tokens
#   3. Generate a new token
# Pricing: Free tier includes $5 credit/month (~500 scrapes)
APIFY_API_TOKEN=your_apify_api_token_here

# ============================================================
# GOOGLE GEMINI AI CONFIGURATION
# ============================================================
# Gemini API Key for AI-powered competitive intelligence analysis
# How to get:
#   1. Go to https://ai.google.dev/
#   2. Click "Get API Key" in Google AI Studio
#   3. Create or select a project
#   4. Generate API key
# Pricing: Free tier includes 60 requests/minute
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# SENDGRID CONFIGURATION (Email Notifications)
# ============================================================
# SendGrid API Key for sending transactional emails
# How to get:
#   1. Create account at https://sendgrid.com
#   2. Go to Settings > API Keys
#   3. Create API Key with "Full Access" or "Mail Send" permission
# Pricing: Free tier includes 100 emails/day
# Used for: Welcome emails, password reset, event alerts, daily summaries
SENDGRID_API_KEY=

# Verified sender email (must be verified in SendGrid)
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Vigilux

# ============================================================
# TWILIO CONFIGURATION (SMS Notifications - Ultimate Plan Only)
# ============================================================
# Twilio credentials for sending SMS alerts
# How to get:
#   1. Create account at https://twilio.com
#   2. Go to Console Dashboard
#   3. Copy Account SID and Auth Token
#   4. Buy a phone number (Phone Numbers > Buy a number)
# Pricing: Pay-as-you-go, ~$0.0075/SMS
# Used for: Critical competitor alerts (score > 80)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================
# SLACK CONFIGURATION (Slack Notifications)
# ============================================================
# Slack Webhook URL for posting competitor alerts to a channel
# How to get:
#   1. Go to https://api.slack.com/apps
#   2. Create New App > From scratch
#   3. Enable "Incoming Webhooks"
#   4. Add New Webhook to Workspace
#   5. Select channel and copy webhook URL
# Pricing: Free
# Note: Each user configures their own webhook in app settings
# This is just for system-wide notifications (optional)
SLACK_WEBHOOK_URL=

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
# API URL for frontend to connect to backend
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time notifications
# Development: ws://localhost:8000
# Production: wss://api.yourdomain.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ============================================================
# ENVIRONMENT & DEBUG
# ============================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (verbose logging, detailed errors)
# MUST be False in production!
DEBUG=True

# ============================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================
# Sentry DSN for error tracking (optional)
# How to get:
#   1. Create account at https://sentry.io
#   2. Create new project
#   3. Copy DSN from project settings
SENTRY_DSN=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================
# NOTES
# ============================================================
# - NEVER commit your .env file to Git (it's in .gitignore)
# - Always use strong, randomly generated SECRET_KEY in production
# - Keep API tokens secure and rotate them periodically
# - Test with free tiers before going to production
# - For production, use environment variables or secrets manager
#   instead of .env file (AWS Secrets Manager, Azure Key Vault, etc.)
